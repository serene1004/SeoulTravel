# Seoul Open Data Plaza API key. Copy this file to .env.local and set your key.
# This key is consumed only by `pnpm sync:seoul-attractions`; do not commit .env.local.
VITE_SEOUL_OPEN_DATA_KEY=
# Use a trusted HTTPS reverse proxy; redact the key path from its access logs.
SEOUL_OPEN_DATA_API_BASE_URL=

# Kakao REST API key. Used only by `pnpm geocode:seoul-attractions`.
KAKAO_REST_API_KEY=

# OpenAI API key. Used by place enrichment and localization review; keep the real key in .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ENRICH_MAX_SPEND_USD=4.5
LOCALIZATION_REVIEW_MAX_SPEND_USD=1
CONTENT_LOCALIZATION_MAX_SPEND_USD=1
TRAVEL_PLACE_REVIEW_MAX_SPEND_USD=1
