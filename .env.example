# Seoul Open Data Plaza API key. Copy this file to .env.local and set your key.
# This key is consumed only by `pnpm sync:seoul-attractions`; do not commit .env.local.
VITE_SEOUL_OPEN_DATA_KEY=

# Kakao REST API key. Used only by `pnpm geocode:seoul-attractions`.
KAKAO_REST_API_KEY=

# OpenAI API key. Used only by `pnpm enrich:travel-places`; keep the real key in .env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ENRICH_MAX_SPEND_USD=4.5
